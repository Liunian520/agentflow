{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lnagent.dev/schemas/agentflow-v1.json",
  "title": "LNAgent AgentFlow Schema v1",
  "description": "Agent 流程定义的 JSON Schema，用于可视化编辑器与 Worker 执行引擎之间的通信协议",
  "version": "1.0.0",
  "type": "object",
  "required": ["version", "id", "name", "graph"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema 版本号 (semver)"
    },
    "id": {
      "type": "string",
      "description": "Agent 唯一标识符",
      "examples": ["agent_001", "code_review_assistant"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Agent 显示名称"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "Agent 功能描述"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "graph": {
      "$ref": "#/$defs/Graph"
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/Variable" },
      "description": "全局变量定义"
    },
    "triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/Trigger" },
      "description": "触发器配置"
    }
  },
  "additionalProperties": false,

  "$defs": {
    "Metadata": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "icon": { "type": "string" },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },

    "Graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/Node" },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/Edge" }
        }
      }
    },

    "Node": {
      "type": "object",
      "required": ["id", "type", "position", "config"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^node_[a-zA-Z0-9_]+$"
        },
        "type": {
          "$ref": "#/$defs/NodeType"
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "config": {
          "$ref": "#/$defs/NodeConfig"
        },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Port" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/Port" }
        },
        "label": { "type": "string" },
        "breakpoint": { "type": "boolean" },
        "disabled": { "type": "boolean" }
      }
    },

    "NodeType": {
      "type": "string",
      "enum": [
        "start", "end", "input", "output",
        "llm", "agent", "subagent", "a2a",
        "tool", "http", "database", "knowledge",
        "condition", "loop", "parallel",
        "memory_read", "memory_write",
        "human_in_loop", "subworkflow", "code"
      ]
    },

    "NodeConfig": {
      "oneOf": [
        { "$ref": "#/$defs/StartConfig" },
        { "$ref": "#/$defs/EndConfig" },
        { "$ref": "#/$defs/LLmConfig" },
        { "$ref": "#/$defs/AgentConfig" },
        { "$ref": "#/$defs/ToolConfig" },
        { "$ref": "#/$defs/HttpConfig" },
        { "$ref": "#/$defs/ConditionConfig" },
        { "$ref": "#/$defs/LoopConfig" },
        { "$ref": "#/$defs/MemoryReadConfig" },
        { "$ref": "#/$defs/MemoryWriteConfig" },
        { "$ref": "#/$defs/SubagentConfig" },
        { "$ref": "#/$defs/HumanInLoopConfig" },
        { "$ref": "#/$defs/SubworkflowConfig" },
        { "$ref": "#/$defs/CodeConfig" }
      ]
    },

    "StartConfig": {
      "type": "object",
      "properties": {
        "inputSchema": { "$ref": "#/$defs/JSONSchema" },
        "defaultValues": { "type": "object" }
      }
    },

    "EndConfig": {
      "type": "object",
      "properties": {
        "outputTemplate": { "type": "string" },
        "responseFormat": {
          "type": "string",
          "enum": ["text", "json", "structured", "stream"]
        }
      }
    },

    "LLmConfig": {
      "type": "object",
      "required": ["model", "systemPrompt", "userPrompt"],
      "properties": {
        "model": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "userPrompt": { "type": "string" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 128000, "default": 4096 },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "memoryProfile": { "type": "string" },
        "streamOutput": { "type": "boolean", "default": true },
        "responseFormat": {
          "type": "string",
          "enum": ["text", "json", "structured"]
        },
        "jsonSchema": { "$ref": "#/$defs/JSONSchema" }
      }
    },

    "AgentConfig": {
      "type": "object",
      "required": ["model", "systemPrompt", "planningMode"],
      "properties": {
        "model": { "type": "string" },
        "systemPrompt": { "type": "string" },
        "planningMode": {
          "type": "string",
          "enum": ["react", "plan-and-execute", "reflection"]
        },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 10, "default": 5 },
        "tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autoToolSelect": { "type": "boolean", "default": true },
        "stopCondition": { "type": "string" }
      }
    },

    "ToolConfig": {
      "type": "object",
      "required": ["toolSource"],
      "properties": {
        "toolSource": {
          "type": "string",
          "enum": ["mcp", "local", "http"]
        },
        "mcpServerId": { "type": "string" },
        "toolName": { "type": "string" },
        "httpConfig": {
          "$ref": "#/$defs/HttpConfig"
        },
        "inputMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "outputMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 300, "default": 30 },
        "retryPolicy": {
          "type": "object",
          "properties": {
            "maxRetries": { "type": "integer", "default": 2 },
            "backoff": {
              "type": "string",
              "enum": ["linear", "exponential"]
            }
          }
        }
      }
    },

    "HttpConfig": {
      "type": "object",
      "required": ["url", "method"],
      "properties": {
        "url": { "type": "string", "format": "uri-template" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"]
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "bodyTemplate": { "type": "string" },
        "queryTemplate": { "type": "string" }
      }
    },

    "ConditionConfig": {
      "type": "object",
      "required": ["branches"],
      "properties": {
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "expression", "targetNodeIds"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "expression": { "type": "string" },
              "targetNodeIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "defaultBranch": {
          "type": "object",
          "properties": {
            "targetNodeIds": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "evaluationMode": {
          "type": "string",
          "enum": ["sync", "async"],
          "default": "sync"
        }
      }
    },

    "LoopConfig": {
      "type": "object",
      "required": ["loopType"],
      "properties": {
        "loopType": {
          "type": "string",
          "enum": ["count", "condition", "forEach"]
        },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100 },
        "condition": { "type": "string" },
        "collection": { "type": "string" },
        "itemVariable": { "type": "string" },
        "indexVariable": { "type": "string" }
      }
    },

    "MemoryReadConfig": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["search", "recall", "list"],
          "default": "search"
        },
        "queryTemplate": { "type": "string" },
        "memoryType": {
          "type": "string",
          "enum": ["working", "episodic", "semantic"]
        },
        "filters": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "dateRange": {
              "type": "object",
              "properties": {
                "start": { "type": "string", "format": "date" },
                "end": { "type": "string", "format": "date" }
              }
            },
            "minImportance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "maxResults": { "type": "integer", "default": 10 },
        "outputFormat": {
          "type": "string",
          "enum": ["text", "structured", "summary"]
        }
      }
    },

    "MemoryWriteConfig": {
      "type": "object",
      "required": ["operation", "memoryType", "contentTemplate"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["save", "update", "delete"]
        },
        "memoryType": {
          "type": "string",
          "enum": ["episodic", "semantic"]
        },
        "contentTemplate": { "type": "string" },
        "metadata": {
          "type": "object",
          "properties": {
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "importance": { "type": "number", "minimum": 0, "maximum": 1 },
            "ttl": { "type": "integer", "minimum": 0 }
          }
        },
        "deduplicate": { "type": "boolean", "default": true }
      }
    },

    "SubagentConfig": {
      "type": "object",
      "required": ["agents"],
      "properties": {
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "model", "systemPrompt"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "model": { "type": "string" },
              "systemPrompt": { "type": "string" },
              "inputVariable": { "type": "string" },
              "tools": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        },
        "aggregatorPrompt": { "type": "string" },
        "outputVariable": { "type": "string" },
        "parallel": { "type": "boolean", "default": true }
      }
    },

    "HumanInLoopConfig": {
      "type": "object",
      "properties": {
        "promptTemplate": { "type": "string" },
        "approvalType": {
          "type": "string",
          "enum": ["confirm", "reject", "edit", "choose"]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "timeout": { "type": "integer", "minimum": 0 },
        "onTimeout": {
          "type": "string",
          "enum": ["approve", "reject", "error"]
        }
      }
    },

    "SubworkflowConfig": {
      "type": "object",
      "required": ["workflowId"],
      "properties": {
        "workflowId": { "type": "string" },
        "inputMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "outputMapping": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "mode": {
          "type": "string",
          "enum": ["sync", "async"],
          "default": "sync"
        }
      }
    },

    "CodeConfig": {
      "type": "object",
      "required": ["language", "code"],
      "properties": {
        "language": {
          "type": "string",
          "enum": ["javascript", "typescript", "python"]
        },
        "code": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout": { "type": "integer", "maximum": 30, "default": 10 }
      }
    },

    "Port": {
      "type": "object",
      "required": ["id", "label", "dataType"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "dataType": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object", "array", "file", "any"]
        }
      }
    },

    "Edge": {
      "type": "object",
      "required": ["id", "source", "sourceHandle", "target", "targetHandle"],
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "target": { "type": "string" },
        "targetHandle": { "type": "string" },
        "condition": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["data", "control"]
            },
            "expression": { "type": "string" }
          }
        },
        "animated": { "type": "boolean" },
        "label": { "type": "string" }
      }
    },

    "Variable": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "object", "array", "file"]
        },
        "value": {},
        "source": {
          "type": "string",
          "enum": ["input", "node_output", "constant", "template"]
        },
        "ref": {
          "type": "object",
          "properties": {
            "nodeId": { "type": "string" },
            "outputId": { "type": "string" }
          }
        },
        "description": { "type": "string" },
        "sensitive": { "type": "boolean" }
      }
    },

    "Trigger": {
      "type": "object",
      "required": ["id", "type", "config"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["manual", "schedule", "event", "webhook"]
        },
        "config": {
          "type": "object",
          "properties": {
            "schedule": {
              "type": "object",
              "properties": {
                "cron": { "type": "string" },
                "timezone": { "type": "string" }
              }
            },
            "event": {
              "type": "object",
              "properties": {
                "source": { "type": "string" },
                "pattern": { "type": "string" }
              }
            },
            "webhook": {
              "type": "object",
              "properties": {
                "path": { "type": "string" },
                "auth": {
                  "type": "string",
                  "enum": ["none", "token", "hmac"]
                }
              }
            }
          }
        },
        "enabled": { "type": "boolean", "default": true }
      }
    },

    "JSONSchema": {
      "type": "object",
      "description": "标准 JSON Schema 2020-12 定义",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["object", "string", "number", "integer", "boolean", "array", "null"]
        },
        "properties": {
          "type": "object"
        }
      }
    }
  },

  "examples": [
    {
      "version": "1.0.0",
      "id": "code_review_bot",
      "name": "代码审查助手",
      "description": "自动审查 PR 代码质量",
      "graph": {
        "nodes": [
          {
            "id": "node_start",
            "type": "start",
            "position": { "x": 0, "y": 100 },
            "config": {}
          },
          {
            "id": "node_llm",
            "type": "llm",
            "position": { "x": 200, "y": 100 },
            "config": {
              "model": "gpt-4o",
              "systemPrompt": "你是代码审查专家...",
              "userPrompt": "请审查以下代码: {{pr_diff}}",
              "temperature": 0.3,
              "tools": ["search_code", "get_pr_info"]
            }
          },
          {
            "id": "node_end",
            "type": "end",
            "position": { "x": 400, "y": 100 },
            "config": {
              "outputTemplate": "# 审查报告\n{{llm_output}}"
            }
          }
        ],
        "edges": [
          {
            "id": "edge_1",
            "source": "node_start",
            "sourceHandle": "out",
            "target": "node_llm",
            "targetHandle": "in"
          },
          {
            "id": "edge_2",
            "source": "node_llm",
            "sourceHandle": "out",
            "target": "node_end",
            "targetHandle": "in"
          }
        ]
      }
    }
  ]
}
